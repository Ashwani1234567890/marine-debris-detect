rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 1. Survey Missions
    match /missions/{missionId} {
      allow get, list: if true; // Publicly readable survey trackline records
      allow create, update: if isSignedIn() && isValidId(missionId) &&
        incoming().name is string && incoming().name.size() <= 128 &&
        incoming().region is string && incoming().region.size() <= 128;
      allow delete: if isSignedIn() && isValidId(missionId);

      // 2. Mission Targets Subcollection
      match /targets/{targetId} {
        allow get, list: if true; // Open read for hydrographic visualizations
        allow create, update: if isSignedIn() && isValidId(targetId) &&
          incoming().id is string && incoming().id.size() <= 64 &&
          incoming().label is string && incoming().label.size() <= 128 &&
          incoming().debrisClass in ['ghost_net', 'pipe', 'container', 'tire', 'uxo', 'drum', 'wreckage', 'cable'] &&
          incoming().modelHead in ['yolov8_obb', 'unet'] &&
          incoming().confidence is number && incoming().confidence >= 0 && incoming().confidence <= 1 &&
          incoming().lat is number && incoming().lon is number;
        allow delete: if isSignedIn() && isValidId(targetId);
      }
    }

    // 3. User Profiles
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create, update: if isOwner(userId) && isValidId(userId) &&
        incoming().uid == request.auth.uid &&
        incoming().email is string && incoming().email.size() <= 128;
      allow delete: if isOwner(userId);
    }

    // Connection test document
    match /test/connection {
      allow read, write: if true;
    }
  }
}
